<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="rise" fetch="ssh://git@github.com/riseproject-dev/"/>
  <default remote="rise" sync-j="4"/>

  <!-- Alibaba A210 bootloader chain. See the manifest repo README for the
       workflow; the entry point for the board is
       build-bootloaders/release_android.sh.

       The kernel.org GNU toolchain is downloaded on first build by
       build-bootloaders/utils.sh. Outputs are staged into the AOSP tree
       under vendor/rise/alibaba/a210/bootloader/.
  -->
  <project path="build-bootloaders" name="android_bootloader_build" revision="alibaba-android-17"/>

  <!-- A210 vendor chain -->
  <project path="u-boot"  name="u-boot"  revision="v2024.10-a210"/>
  <project path="opensbi" name="opensbi" revision="v1.5-a210"/>

</manifest>
